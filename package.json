{
  "name": "cineva",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=@cineva/server",
    "dev:web": "npm run dev --workspace=@cineva/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start:share": "node scripts/start-share.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3"
  }
}
