# ==============================================================================
# SYNCWATCH ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or configure in your deployment dashboard)
# IMPORTANT: Never commit .env with real production secrets to version control.
# ==============================================================================

# ==============================================================================
# SECTION 1: SERVER-ONLY VARIABLES (CONFIDENTIAL - NEVER EXPOSE TO CLIENT)
# ==============================================================================

# Server Network & Runtime Environment
PORT=4000
NODE_ENV=development # 'development' | 'production' | 'test'

# CORS & Domain Configuration
# In development: http://localhost:5173
# In production: https://your-production-domain.com
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://syncwatch.app

# Database Connection
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (Default):
# Zero-setup local SQLite database:
DATABASE_URL="file:./dev.db"
#
# PRODUCTION POSTGRESQL:
# Supported providers: Supabase, Neon, AWS RDS, Railway, DigitalOcean
# DATABASE_URL="postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres?sslmode=require"

# Media Storage Configuration
# ------------------------------------------------------------------------------
# Driver: 'local' for filesystem disk storage (dev), 's3' for object storage (prod)
STORAGE_DRIVER=local

# Local Storage Options (used when STORAGE_DRIVER=local)
MEDIA_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=5120 # 5 GB per file (5,368,709,120 bytes)

# S3 / Object Storage Options (used when STORAGE_DRIVER=s3)
# Compatible with AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces
S3_BUCKET=syncwatch-media-production
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com # For Cloudflare R2 or MinIO
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_PUBLIC_BASE_URL=https://media.syncwatch.app # Optional CloudFront / CDN distribution
S3_FORCE_PATH_STYLE=false

# Horizontal Scaling (Optional)
# ------------------------------------------------------------------------------
# Redis instance for Socket.IO multi-server cluster adapter
# REDIS_URL=redis://default:yourpassword@redis-instance:6379

# Session & Room Security
# ------------------------------------------------------------------------------
SESSION_SECRET=syncwatch_super_secret_cryptographic_key_change_me_in_prod

# ==============================================================================
# SECTION 2: PUBLIC / CLIENT-SAFE VARIABLES (PREFIXED WITH VITE_)
# ==============================================================================
# These variables are compiled into the client-side JavaScript bundle.
# ONLY put public URLs here. NEVER put database credentials or secrets here!

# Backend API & WebSocket Server URLs
# In development (Vite dev proxy handles /api and /socket.io):
VITE_API_URL=
VITE_SOCKET_URL=

# In production with separate frontend & backend domains:
# VITE_API_URL=https://api.syncwatch.app
# VITE_SOCKET_URL=https://api.syncwatch.app
