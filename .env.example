# Local server defaults
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=file:./dev.db
MEDIA_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=15360
MAX_TOTAL_STORAGE_GB=40
MAX_CONCURRENT_ROOMS=100
ENABLE_TUNNEL=false
KEEP_AWAKE=false

# Optional Redis adapter for multi-server Socket.IO deployments
# REDIS_URL=redis://localhost:6379

# Public client URLs; leave empty for the same-origin setup
VITE_API_URL=
VITE_SOCKET_URL=
VITE_APP_URL=
