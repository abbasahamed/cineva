# ==============================================================================
# CINEVA PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Copy this file to .env in your production environment (e.g., Railway, Render,
# Fly.io, AWS, DigitalOcean) and fill in your actual production values.
#
# IMPORTANT:
# 1. SERVER-ONLY variables must NEVER be exposed to the frontend browser.
# 2. PUBLIC variables (prefixed with VITE_) are compiled into the client bundle.
# ==============================================================================

# ==============================================================================
# 1. SERVER-ONLY CONFIDENTIAL VARIABLES (BACKEND SERVER ONLY)
# ==============================================================================

# Node Runtime Environment
NODE_ENV=production
PORT=4000

# Domain & CORS Origins (Specify your exact production frontend URL)
CLIENT_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# PostgreSQL Database Connection
# Supported providers: Neon, Supabase, AWS RDS, Railway Postgres
DATABASE_URL=postgresql://username:password@db-host.provider.com:5432/cineva?sslmode=require

# Media Storage Configuration
# Set STORAGE_DRIVER=s3 to enable AWS S3 / Cloudflare R2 object storage
STORAGE_DRIVER=s3
S3_BUCKET=your-production-bucket-name
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com # Optional: For Cloudflare R2 / MinIO
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_PUBLIC_BASE_URL=https://media.your-domain.com # Optional: Custom CDN / CloudFront domain
S3_FORCE_PATH_STYLE=false
MAX_FILE_SIZE_MB=5120 # 5 GB per file (5,368,709,120 bytes)

# Session Security Secret
# Generate a cryptographically secure 256-bit secret string using OpenSSL:
# Command: openssl rand -base64 48
SESSION_SECRET=generate-a-secure-random-secret

# Optional: Redis Adapter URL for Socket.IO Multi-Server Horizontal Scaling
# REDIS_URL=redis://default:password@redis-host:6379

# ==============================================================================
# 2. PUBLIC CLIENT-SAFE VARIABLES (COMPILED INTO FRONTEND VITE BUNDLE)
# ==============================================================================

# Public API & WebSocket URLs for the React Client
# Leave empty if using reverse-proxy on the same domain (e.g., Nginx routing /api to port 4000)
VITE_API_URL=https://api.your-domain.com
VITE_SOCKET_URL=https://api.your-domain.com

# Public deployed CINEVA domain used for shareable room invitations (WhatsApp, messaging):
VITE_APP_URL=https://your-domain.com

