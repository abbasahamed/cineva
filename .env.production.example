# Server settings
NODE_ENV=production
PORT=4000
CLIENT_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example
DATABASE_URL=postgresql://username:password@db-host.example:5432/cineva
MEDIA_STORAGE_PATH=/srv/cineva/uploads
MAX_FILE_SIZE_MB=10240
MAX_TOTAL_STORAGE_GB=40
MAX_CONCURRENT_ROOMS=50
ENABLE_TUNNEL=true
KEEP_AWAKE=true

# Optional Redis adapter for multi-server Socket.IO deployments
# REDIS_URL=redis://username:password@redis-host:6379

# Public client URLs; these are included in the browser bundle
VITE_API_URL=
VITE_SOCKET_URL=
VITE_APP_URL=https://your-domain.example
