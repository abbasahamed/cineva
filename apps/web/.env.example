# Public Frontend Environment Variables
# Note: Vite exposes only variables prefixed with VITE_ to the client bundle.

# Leave empty if using reverse-proxy (e.g. Nginx / Caddy routing /api to backend):
VITE_API_URL=
VITE_SOCKET_URL=

# If backend is hosted on a separate subdomain:
# VITE_API_URL=https://api.cineva.app
# VITE_SOCKET_URL=https://api.cineva.app
