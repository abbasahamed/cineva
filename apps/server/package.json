{
  "name": "@cineva/server",
  "version": "1.0.0",
  "description": "Backend API, WebSocket synchronization engine, and media pipeline for CINEVA",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build --workspace=@cineva/shared && node scripts/generate-prisma.js && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false --exclude='**/dist/**'",
    "db:push": "node scripts/generate-prisma.js && node scripts/db-push.js",
    "db:generate": "node scripts/generate-prisma.js"
  },
  "dependencies": {
    "@cineva/shared": "*",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "nanoid": "^5.1.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
